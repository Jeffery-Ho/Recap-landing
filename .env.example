# Public URL only. Leave empty until the invitation is available.
PUBLIC_TESTFLIGHT_URL=
# Public business email. Never put credentials in these values.
PUBLIC_CONTACT_EMAIL=
# Set only after confirming the public beta supports the advertised features.
BETA_FEATURES_VERIFIED=false
# Set only after the owner approves both localized legal documents.
LEGAL_CONTENT_APPROVED=false
# Required in the Cloudflare Pages production build environment.
# Keep false or unset for local and branch previews.
RECAP_RELEASE=false
