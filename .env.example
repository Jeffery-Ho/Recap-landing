# Public TestFlight invitation; defaults to the current Recap beta when unset. Set empty to show “coming soon”.
PUBLIC_TESTFLIGHT_URL=https://testflight.apple.com/join/zhd3PaV4
# Public support/privacy email. Never put credentials in these values.
PUBLIC_CONTACT_EMAIL=support@recapmoments.app
# Set only after confirming the public beta supports the advertised features.
BETA_FEATURES_VERIFIED=false
# Current legal documents approved for publication; use false for review drafts.
LEGAL_CONTENT_APPROVED=true
# Required in the Cloudflare Pages production build environment.
# Keep false or unset for local and branch previews.
RECAP_RELEASE=false
