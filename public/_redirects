# Retired v2 preview paths permanently move to the equivalent root URL.
# Query strings are preserved by the host. Relative destinations avoid host loops.
/v2 / 301
/v2/ / 301
/v2/* /:splat 301

# Match production: Vercel already 308s the apex host to www. Both hostnames must
# first be attached in Cloudflare Pages if this file is used there.
https://recapmoments.app/* https://www.recapmoments.app/:splat 301
