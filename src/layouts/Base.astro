---
import '../styles/global.css';
import zhTitleFont from '../assets/fonts/noto-serif-sc-500.woff2';
import BetaButton from '../components/BetaButton.astro';
import { copy, isPreviewBuild, localPath, site, sitePath, withBase, type Locale } from '../data/site';
interface Props { locale: Locale; page?: string; title?: string; description?: string; noindex?: boolean; }
const { locale, page = '', title, description, noindex = false } = Astro.props;
const t = copy[locale];
const home = localPath(locale);
const canonical = new URL(sitePath(locale, page), site.origin).href;
const contactHref = localPath(locale, 'contact');
const pageTitle = title ?? t.title;
const pageDescription = description ?? t.description;
const isHome = page === '';
const navLinks = [
  { href: `${home}#features`, label: t.nav.features },
  { href: `${home}#pricing`, label: t.nav.pricing },
  { href: `${home}#faq`, label: t.nav.faq },
  { href: localPath(locale, 'contact'), label: t.contact },
];
---
<!doctype html>
<html lang={t.lang} data-past-hero={isHome ? undefined : "true"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f5f3" />
    <script is:inline>
      // Theme before first paint, as on Polaris: the visitor's saved choice, else the system setting.
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let saved = null;
        try { saved = localStorage.getItem('recap-theme'); } catch {}
        const system = matchMedia('(prefers-color-scheme: dark)');
        const apply = (theme) => {
          root.dataset.theme = theme;
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#121211' : '#f6f5f3');
        };
        apply(saved === 'dark' || saved === 'light' ? saved : system.matches ? 'dark' : 'light');
        window.recapSetTheme = (theme) => {
          apply(theme);
          try { localStorage.setItem('recap-theme', theme); } catch {}
        };
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {(noindex || isPreviewBuild) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(sitePath('en', page), site.origin).href} />
    <link rel="alternate" hreflang="zh-Hans" href={new URL(sitePath('zh', page), site.origin).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(sitePath('en', page), site.origin).href} />
    {locale === 'zh' && isHome && <link rel="preload" href={zhTitleFont} as="font" type="font/woff2" crossorigin />}
    <link rel="icon" type="image/png" href={withBase('/app-icon.png')} />
    <link rel="apple-touch-icon" href={withBase('/app-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Recap" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={`${site.origin}/app-icon.png`} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="Recap — a white fish on a black app icon" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${site.origin}/app-icon.png`} />
  </head>
  <body class:list={[{ 'locale-zh': locale === 'zh' }]}>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="nav-pill">
        <a class="brand" href={home} aria-label="Recap">
          <img src={withBase('/app-icon.png')} width="34" height="34" alt="" />
          <span class="brand-name">Recap</span>
        </a>
        <nav class="header-links" aria-label={t.nav.menu}>
          {navLinks.map((link) => <a class="header-link" href={link.href}>{link.label}</a>)}
        </nav>
      </div>
      <div class="header-tools">
        <div class="nav-beta"><BetaButton locale={locale} compact /></div>
        <div class="theme-toggle" role="group" aria-label={t.themeLabel}>
          <button class="theme-option" type="button" data-theme-option="dark" aria-label={t.themeDark} aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z" /></svg>
          </button>
          <button class="theme-option" type="button" data-theme-option="light" aria-label={t.themeLight} aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
          </button>
        </div>
        <details class="menu">
          <summary aria-label={t.nav.menu}><span></span><span></span></summary>
          <nav class="menu-panel" aria-label={t.nav.menu}>
            {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="footer-brand" href={home}><img src={withBase('/app-icon.png')} width="34" height="34" alt="" loading="lazy" />Recap</a>
          <p class="footer-tagline">{t.footer.tagline}</p>
        </div>
        <nav class="footer-col" aria-labelledby="footer-product">
          <h2 id="footer-product">{t.footer.product}</h2>
          <ul>
            <li><a href={`${home}#features`}>{t.nav.features}</a></li>
            <li><a href={`${home}#pricing`}>{t.nav.pricing}</a></li>
            <li><a href={localPath(locale, 'changelog')}>{t.updates.title}</a></li>
          </ul>
        </nav>
        <nav class="footer-col" aria-labelledby="footer-support">
          <h2 id="footer-support">{t.footer.support}</h2>
          <ul>
            <li><a href={`${home}#install`}>{t.footer.install}</a></li>
            <li><a href={`${home}#faq`}>{t.nav.faq}</a></li>
            <li><a href={contactHref}>{t.contact}</a></li>
          </ul>
        </nav>
        <nav class="footer-col" aria-labelledby="footer-legal">
          <h2 id="footer-legal">{t.footer.legal}</h2>
          <ul>
            <li><a href={localPath(locale, 'privacy')}>{t.privacy}</a></li>
            <li><a href={localPath(locale, 'terms')}>{t.terms}</a></li>
            <li><a href={localPath(locale, 'credits')}>{t.credits}</a></li>
          </ul>
        </nav>
      </div>
      <div class="container footer-bottom">
        <div class="footer-bottom-start">
          <span>© 2026 Recap · {site.operator}</span>
          {/* Language switch in the footer, after Polaris: a pill with the current language that opens a menu upward. */}
          <details class="language-control">
            <summary class="language-toggle" aria-label={t.languageMenuLabel}>
              <svg class="language-toggle-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h10M8 3v2M10.5 5c-.9 3.6-3 6.6-6 8.5M6 8.5c1.2 2 2.9 3.6 5 4.7M13 21l4-9 4 9M14.4 18h5.2" /></svg>
              <span>{locale === 'en' ? 'English' : '简体中文'}</span>
              <svg class="language-toggle-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <div class="language-menu">
              <a href={localPath('en', page)} lang="en" hreflang="en" aria-current={locale === 'en' ? 'true' : undefined} data-language-switch={locale === 'en' ? undefined : true}>English</a>
              <a href={localPath('zh', page)} lang="zh-Hans" hreflang="zh-Hans" aria-current={locale === 'zh' ? 'true' : undefined} data-language-switch={locale === 'zh' ? undefined : true}>简体中文</a>
            </div>
          </details>
        </div>
        <p class="footer-made">
          {t.footer.made}<svg class="footer-heart" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" focusable="false"><path d="M12 21 3.5 12.5a5.3 5.3 0 0 1 7.5-7.5L12 6l1-1a5.3 5.3 0 0 1 7.5 7.5Z" /></svg><span class="sr-only">{t.footer.love}</span>
          <a href={site.developer.url} target="_blank" rel="noreferrer">{site.developer.name}</a>
        </p>
      </div>
    </footer>
    <script>import '../scripts/motion.ts'; import '../scripts/interactive.ts';</script>
  </body>
</html>
