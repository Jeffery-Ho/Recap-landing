---
import { copy, site, type Locale } from '../data/site';
import { ArrowUpRight } from '@lucide/astro';
interface Props { locale: Locale; compact?: boolean; size?: 'hero'; variant?: 'primary' | 'outline' | 'neutral' | 'badge' | 'dark'; }
const { locale, compact = false, size, variant = 'primary' } = Astro.props;
const t = copy[locale];
const classes = ['button', `button-${variant}`, { 'button-small': compact, 'button-hero': size === 'hero' }];
// `badge` reads like a store badge (after hive.ink's download badges), without Apple's marks.
---
{site.testflightUrl ? (
  variant === 'dark' ? (
    <a class="button button-dark" href={site.testflightUrl} data-beta-cta>
      <svg class="apple-logo" viewBox="0 0 17 20" aria-hidden="true"><path d="M14.1 10.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9C3.6 4.8 2 5.8 1.1 7.4c-1.9 3.2-.5 8 1.3 10.6.9 1.3 1.9 2.7 3.3 2.6 1.3-.1 1.8-.9 3.4-.9s2 .9 3.4.8c1.4 0 2.3-1.3 3.2-2.6 1-1.5 1.4-2.9 1.4-3-.1 0-2.9-1.1-3-4.3ZM11.5 3c.7-.9 1.2-2 1.1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3-1.5Z"/></svg>{t.join}
    </a>
  ) : variant === 'badge' ? (
    <a class="store-badge" href={site.testflightUrl} data-beta-cta>
      <svg class="apple-logo" viewBox="0 0 17 20" aria-hidden="true"><path d="M14.1 10.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9C3.6 4.8 2 5.8 1.1 7.4c-1.9 3.2-.5 8 1.3 10.6.9 1.3 1.9 2.7 3.3 2.6 1.3-.1 1.8-.9 3.4-.9s2 .9 3.4.8c1.4 0 2.3-1.3 3.2-2.6 1-1.5 1.4-2.9 1.4-3-.1 0-2.9-1.1-3-4.3ZM11.5 3c.7-.9 1.2-2 1.1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3-1.5Z"/></svg>
      <span><small>{t.badge.join}</small><strong>{t.badge.joinMain}</strong></span>
    </a>
  ) : (
    <a class:list={classes} href={site.testflightUrl} data-beta-cta>
      {t.join}<ArrowUpRight size={17} aria-hidden="true" />
    </a>
  )
) : (
  <span class:list={[...classes, 'button-pending']} role="status" data-beta-cta data-beta-pending>
    {t.pending}<span class="pending-dot" aria-hidden="true"></span>
  </span>
)}
