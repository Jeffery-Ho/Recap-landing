---
// The TestFlight badge (links to the public beta) next to a muted "coming soon" App Store badge, after hive.ink.
import { Store } from '@lucide/astro';
import BetaButton from './BetaButton.astro';
import { copy, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const b = copy[locale].badge;
---
<div class="store-badges">
  <BetaButton locale={locale} variant="badge" />
  <span class="store-badge store-badge-soon" role="status">
    <Store size={24} stroke-width={1.6} aria-hidden="true" />
    <span><small>{b.soon}</small><strong>{b.soonMain}</strong></span>
  </span>
</div>
