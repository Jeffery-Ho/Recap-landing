---
import Base from '../layouts/Base.astro';
import { copy, localPath, type Locale } from '../data/site';
import photos from '../data/photography-sources.json';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
---
<Base locale={locale} page="credits" title={`${t.credits} — Recap`}>
  <article class="container legal-page"><p class="eyebrow">RECAP / CREDITS</p><h1>{t.credits}</h1>
    <section><p>{locale === 'en' ? 'Every travel, theme, and demo photograph on this site is sourced from Unsplash.' : '本站旅行、主题和演示照片均来自 Unsplash。'}</p><ul>{photos.map((photo) => <li><a href={photo.source}>{locale === 'en' ? photo.name : photo.nameZh} — {photo.photographer}</a></li>)}</ul><p><a href="https://unsplash.com/license">Unsplash License</a></p></section>
    <section><h2>{locale === 'en' ? 'App screens' : 'App 界面'}</h2><p>{locale === 'en' ? 'The hero screens are captured from the latest Recap build running on the iPhone Duo (unfolded) and iPhone Air simulators, with demonstration photos. Device frames are Apple’s official product bezels from Apple Design Resources. The feature photo strips use Recap’s demonstration library and onboarding photographs from Unsplash; weeks, places and counts are demonstration data. Feature illustrations are redrawn from Recap’s onboarding pages; they are not App screenshots. No screen shows a user’s private library.' : '首屏画面来自 iPhone Duo（展开）与 iPhone Air 模拟器上运行的最新 Recap 构建，照片为演示数据；机身为 Apple Design Resources 提供的官方设备外框。功能区照片条使用 Recap 演示图库与引导页的 Unsplash 照片，周次、地点与数量为演示数据。功能插画依据 Recap 引导页重绘，并非 App 截图。没有展示用户的私人相册。'}</p></section>
    <a class="button button-secondary" href={localPath(locale)}>{t.back}<span aria-hidden="true">↗</span></a>
  </article>
</Base>
