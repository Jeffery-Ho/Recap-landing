---
import Base from '../layouts/Base.astro';
import { copy, localPath, type Locale } from '../data/site';
import legacy from '../data/photography-sources.json';
import library from '../../photos/manifest.json';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
// The shared photo library first (no photographer recorded), then the hero's older registered photos.
const photos: { name: string; nameZh: string; source: string; photographer?: string }[] = [...library.photos, ...legacy];
---
<Base locale={locale} page="credits" title={`${t.credits} — Recap`}>
  <article class="container legal-page"><p class="eyebrow">RECAP / CREDITS</p><h1>{t.credits}</h1>
    <section><p>{locale === 'en' ? 'Every travel, theme, and demo photograph on this site is sourced from Unsplash.' : '本站旅行、主题和演示照片均来自 Unsplash。'}</p><ul>{photos.map((photo) => <li><a href={photo.source}>{locale === 'en' ? photo.name : photo.nameZh}{photo.photographer && ` — ${photo.photographer}`}</a></li>)}</ul><p><a href="https://unsplash.com/license">Unsplash License</a></p></section>
    <section><h2>{locale === 'en' ? 'App screens' : 'App 界面'}</h2><p>{locale === 'en' ? 'The hero screen is captured from the latest Recap build running on the iPhone Duo (unfolded) simulator, with demonstration photos. Device frames are Apple’s official product bezels and hands from Recap’s onboarding artwork; the Shuffle Mode iPhone is drawn in CSS. The This Week section and the onboarding clips are screen recordings from the same build on the iPhone Air simulator. Feature photos come from Unsplash, including travel photos of Kyoto, Okinawa, Tokyo and Nagoya; weeks, places, counts, dates and the photo heatmap are demonstration data. No screen shows a user’s private library.' : '首屏画面来自 iPhone Duo（展开）模拟器上运行的最新 Recap 构建，照片为演示数据；机身为 Apple 官方设备外框与 Recap 引导页的双手素材，随机模式中的 iPhone 由 CSS 绘制。“本周”区块与引导页片段为同一构建在 iPhone Air 模拟器上的录屏。功能区照片来自 Unsplash，包括京都、冲绳、东京、名古屋的旅行照片；周次、地点、数量、日期与拍照热力图均为演示数据。没有展示用户的私人相册。'}</p></section>
    <a class="button button-secondary" href={localPath(locale)}>{t.back}<span aria-hidden="true">↗</span></a>
  </article>
</Base>
