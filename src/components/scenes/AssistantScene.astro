---
import { Image } from 'astro:assets';
import { Sparkles } from '@lucide/astro';
import { copy, type Locale } from '../../data/site';
import openSea from '../../assets/library/weekly-sea-detail.jpg';
import shore from '../../assets/library/themes-seaAttraction-02.jpg';
import beachSunset from '../../assets/library/themes-sunsetBeach-02.jpg';
interface Props { locale: Locale; owned?: boolean; }
const { locale, owned = false } = Astro.props;
const s = copy[locale].scenes;
const photos = [openSea, shore, beachSunset];
---
<div class="scene scene-assistant" data-scene data-owned={owned || undefined} aria-hidden="true">
  <div class="a-results">
    <small>{s.results}</small>
    <div class="a-grid">{photos.map((photo, i) => <div style={`--i:${i}`}><Image src={photo} alt="" widths={[200, 400]} sizes="(max-width: 860px) 100px, 180px" format="webp" loading="lazy" /></div>)}</div>
  </div>
  <span class="a-searching"><Sparkles aria-hidden="true" />{s.searching}</span>
  <div class="a-bar s-glass"><Sparkles aria-hidden="true" /><span data-type={s.query}>{s.query}</span><i class="a-caret"></i></div>
</div>
