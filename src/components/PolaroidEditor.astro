---
// An instant print the visitor can edit, drawn to Recap's own print (WeeklyPhotoPolaroidFrameView,
// WeeklyShareTemplateLayout, WeeklyPhotoPolaroidBackView), with an even border on all four sides (the caption row sits
// inside it, under a 4:5 photo), 4pt corners, an off-white paper gradient with a fine edge; under the photo one row with the caption on the left and
// the serif "Recap" signature with the app icon on the right. The back is the dark film side: grey printed bands top and
// bottom, and the capture date, time and place in monospaced type. Sizes use the card width (cqw) so they follow the
// app's 344pt reference paper. interactive.ts wires paper color and flip, and types a few captions in turn while the print is on screen; without JavaScript the front shows.
import { Image } from 'astro:assets';
import { slot } from '../data/photos';
import { withBase } from '../data/site';
const [sea] = slot('print');
interface Props {
  copy: { colors: string; flip: string; colorNames: readonly string[]; text: string; captions: readonly string[]; time: string; place: string; signature: string; alt: string };
}
const { copy: p } = Astro.props;
const swatches = ['#ffffff', '#f3ead8', '#d9e4d6', '#d7e5ee', '#f3dcd8', '#24292b'];
const slogan = Array.from({ length: 4 }, () => "Don't put in mouth.");
---
<div class="print-editor" data-print>
  <div class="print-stage">
    <div class="print-card" data-print-card style={`--paper:${swatches[0]}`}>
      <figure class="print-face print-front">
        <div class="print-photo"><Image src={sea} alt={p.alt} widths={[400, 800]} sizes="(max-width: 800px) 60vw, 260px" format="webp" loading="lazy" /></div>
        <figcaption class="print-row">
          <span class="print-caption" data-print-caption data-captions={JSON.stringify(p.captions)}>{p.text}</span>
          <span class="print-brand">{p.signature}<img src={withBase('/app-icon.png')} width="42" height="42" alt="" loading="lazy" /></span>
        </figcaption>
      </figure>
      <div class="print-face print-back" aria-hidden="true">
        <div class="print-band print-band--top">{slogan.map((line) => <span><svg viewBox="0 0 12 8"><path d="M1 3.2C2.6 1 4.4.8 6 2.2 7.6.8 9.4 1 11 3.2 9.6 6 7.8 7.2 6 7.2S2.4 6 1 3.2Z" /></svg><i>{line}</i></span>)}</div>
        <div class="print-back-info">
          <p class="print-back-time">{p.time}</p>
          <p class="print-back-place">{p.place}</p>
        </div>
        <div class="print-band print-band--bottom"><b>Recap</b><b>Recap</b></div>
      </div>
    </div>
  </div>
  <div class="print-controls">
    <div class="print-swatches" role="radiogroup" aria-label={p.colors}>
      {swatches.map((color, i) => (
        <button type="button" class="print-swatch" role="radio" aria-checked={i === 0 ? 'true' : 'false'} aria-label={p.colorNames[i]}
          style={`--swatch:${color}`} data-print-color={color}></button>
      ))}
    </div>
    <button type="button" class="print-flip" data-print-flip aria-pressed="false">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 8a6 6 0 0 1 10.5-3.5L16 6M16 2.5V6h-3.5M16 12a6 6 0 0 1-10.5 3.5L4 14M4 17.5V14h3.5" /></svg>
      <span>{p.flip}</span>
    </button>
  </div>
</div>
