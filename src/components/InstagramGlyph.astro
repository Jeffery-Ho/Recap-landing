---
// Instagram's current app icon glyph, drawn in white on its gradient tile (magenta top, red-orange middle, yellow at
// the bottom left), as the iOS share sheet shows it. The tile color lives in CSS (.ig-tile).
interface Props { id?: string; class?: string; }
const { class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" aria-hidden="true">
  <g fill="none" stroke="#fff" stroke-width="2.3">
    <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5.6" />
    <circle cx="12" cy="12" r="4.1" />
  </g>
  <circle cx="17.1" cy="6.9" r="1.4" fill="#fff" />
</svg>
