---
// Pairs of features, after savee.com's "More than a place to save.": a centred two-part title,
// then two equal cards, each a large visual over a bold title and one line.
import OnboardingVideo from '../OnboardingVideo.astro';
import AssistantScene from '../scenes/AssistantScene.astro';
import ShareScene from '../scenes/ShareScene.astro';
import { copy, type Locale } from '../../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const groups = copy[locale].more.groups;
// Live Photo and past weeks loop recordings of the app's onboarding; the Live Photo one shows a localized Share button.
const videos: Record<string, string> = { live: locale === 'en' ? 'live-en' : 'live-zh', past: 'past' };
const scenes: Record<string, typeof AssistantScene> = { assistant: AssistantScene, share: ShareScene };
---
{groups.map((group, g) => (
  <section class="section pair-section container" aria-labelledby={`pair-${g}-title`}>
    <h2 id={`pair-${g}-title`} class="section-title" data-enter><span>{group.title[0]}</span> <span class="muted">{group.title[1]}</span></h2>
    {group.note && <p class="block-note" data-enter>{group.note}</p>}
    <div class="pair-grid">
      {group.cards.map((card) => {
        const Scene = scenes[card.id];
        return (
          <article class="pair-card" data-enter>
            {videos[card.id]
              ? <div class="pair-visual video-frame"><OnboardingVideo name={videos[card.id]} /></div>
              : <div class="pair-visual"><Scene locale={locale} /></div>}
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        );
      })}
    </div>
  </section>
))}
