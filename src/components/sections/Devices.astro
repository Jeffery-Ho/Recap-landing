---
// The app on iPhone Duo (unfolded) and iPhone Air, captured from the mock branch build in Apple's official bezels.
import { Image } from 'astro:assets';
import { copy, type Locale } from '../../data/site';
import duoZh from '../../assets/mockups/duo-open-zh.png';
import duoEn from '../../assets/mockups/duo-open-en.png';
import phoneZh from '../../assets/mockups/air-home-zh.png';
import phoneEn from '../../assets/mockups/air-home-en.png';
import phoneZhDark from '../../assets/mockups/air-home-zh-dark.png';
import phoneEnDark from '../../assets/mockups/air-home-en-dark.png';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const d = t.devicesSection;
const duo = locale === 'en' ? duoEn : duoZh;
const phone = locale === 'en' ? phoneEn : phoneZh;
const phoneDark = locale === 'en' ? phoneEnDark : phoneZhDark;
---
<section class="section devices-section" aria-labelledby="devices-title">
  <div class="container">
    <h2 id="devices-title" class="section-title" data-enter><span>{d.title[0]}</span> <span class="muted">{d.title[1]}</span></h2>
    <p class="feature-body" data-enter>{d.body}</p>
  </div>
  <div class="devices" data-enter>
    <div class="devices-row">
      <Image class="hero-duo" src={duo} alt={t.heroAlt} widths={[960, 1600, 2400]} sizes="(max-width: 640px) 92vw, 800px" format="webp" loading="lazy" />
      <div class="hero-air">
        <Image class="only-light" src={phone} alt={t.heroAltPhone} widths={[320, 640, 960]} sizes="(max-width: 640px) 30vw, 260px" format="webp" loading="lazy" />
        <Image class="only-dark" src={phoneDark} alt={t.heroAltPhone} widths={[320, 640, 960]} sizes="(max-width: 640px) 30vw, 260px" format="webp" loading="lazy" />
      </div>
    </div>
  </div>
</section>
