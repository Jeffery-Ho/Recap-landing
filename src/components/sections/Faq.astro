---
import { Plus } from '@lucide/astro';
import { copy, site, type Locale } from '../../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const installAnswer = locale === 'en'
  ? 'Open the public invitation using a beta button on this page. Install Apple’s TestFlight, accept the invitation, then install Recap. TestFlight availability is managed by Apple and the developer.'
  : '点击页面上的测试按钮，打开公开邀请。安装 Apple TestFlight、接受邀请后，即可安装 Recap。测试名额和可用性由 Apple 与开发者管理。';
---
<section id="faq" class="section container" aria-labelledby="faq-title">
  <div class="faq-inner">
    <h2 id="faq-title" class="section-title" data-enter>{t.faqTitle}</h2>
    <div class="faq-list" data-enter>
      {t.questions.map((item) => (
        <details id={item.id}>
          <summary>{item.question}<span aria-hidden="true" class="faq-toggle"><Plus size={20} stroke-width={1.6} /></span></summary>
          <div class="faq-answer"><p>{item.id === 'installation' && site.testflightUrl ? installAnswer : item.answer}</p>{item.id === 'contact' && site.contactEmail && <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}</div>
        </details>
      ))}
    </div>
  </div>
</section>
