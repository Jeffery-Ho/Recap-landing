---
import { Plus } from '@lucide/astro';
import { copy, faqItems, site, type Locale } from '../../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const questions = faqItems(locale);
---
<section id="faq" class="section container" aria-labelledby="faq-title">
  <div class="faq-inner">
    <h2 id="faq-title" class="section-title" data-enter>{t.faqTitle}</h2>
    <div class="faq-list" data-enter>
      {questions.map((item) => (
        <details id={item.id}>
          <summary>{item.question}<span aria-hidden="true" class="faq-toggle"><Plus size={20} stroke-width={1.6} /></span></summary>
          <div class="faq-answer"><p>{item.answer}</p>{item.id === 'contact' && site.contactEmail && <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}</div>
        </details>
      ))}
    </div>
  </div>
</section>
