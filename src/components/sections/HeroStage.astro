---
// The hero visual, after placify.app: two hands holding iPhone Duo unfolded in landscape on the Gallery (composed from the
// app's own random-mode onboarding layers: the right hand and its mirror, the two bezel halves, and an inner-display capture), with photo cards on
// both sides that take turns fading out, swapping to another photo and fading back in (motion.ts).
// The cards sit on a mirrored grid: an outer column of three portrait cards per side, plus one square card beside the
// headline, all upright. Each card holds the whole pool and shows one photo at a time. Narrow screens hide the cards: the hands fill the width.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { copy, type Locale } from '../../data/site';
import { slot } from '../../data/photos';
import handEn from '../../assets/mockups/hero-duo-gallery-v3-en.png';
import handZh from '../../assets/mockups/hero-duo-gallery-v3-zh.png';
import handEnDark from '../../assets/mockups/hero-duo-gallery-v3-en-dark.png';
import handZhDark from '../../assets/mockups/hero-duo-gallery-v3-zh-dark.png';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const s = copy[locale].heroStage;
const en = locale === 'en';
// The cards use the shared, graded travel set (photos/manifest.json, web slot hero:wall): quiet, faceless streets, rivers
// and coast, none of them used further down the page.
const pool: ImageMetadata[] = slot('hero:wall');
// [x offset from the page centre in px, y % of the hero, size, band]. Offsets keep the cards a fixed distance from the
// hands (the hand image is 880px wide) instead of drifting outward on wide screens. Outer columns portrait, inner square.
const outer = { w: 140, r: 1.25 };
const inner = { w: 116, r: 1 };
const grid: [number, number, typeof outer, 'text' | 'stage' | 'edge'][] = [
  [-530, 22, outer, 'text'], [-530, 50, outer, 'edge'], [-530, 78, outer, 'stage'],
  [-380, 36, inner, 'text'],
  [530, 22, outer, 'text'], [530, 50, outer, 'edge'], [530, 78, outer, 'stage'],
  [380, 36, inner, 'text'],
];
const cards = grid.map(([x, y, size, band], i) => ({
  x, y, band, ...size,
  photos: pool.map((_, k) => pool[(i + k) % pool.length]),
}));
---
<div class="hero-cards" role="img" aria-label={s.label} data-hero-cards>
  {cards.map((card, i) => (
    <div class="hero-card is-on" data-hero-card data-band={card.band} style={`--x:calc(50% + ${card.x}px);--y:${card.y}%;--w:${card.w}px;--r:${card.r};--side:${card.x < 0 ? -1 : 1}`}>
      <div class="hero-card-media">
        {card.photos.map((src, k) => (
          <Image class:list={{ 'is-current': k === 0 }} src={src} alt="" widths={[160, 320]} sizes="140px" format="webp"
            loading={k === 0 ? 'eager' : 'lazy'} data-photo={(i + k) % pool.length} data-loop-copy={k === 0 ? undefined : ''} />
        ))}
      </div>
    </div>
  ))}
</div>
<div class="hero-hand" data-hero-line style="--i:4">
  <Image class="only-light" src={en ? handEn : handZh} alt={s.hand} widths={[640, 960, 1400, 1800]} sizes="(max-width: 640px) 120vw, 880px"
    format="webp" loading="eager" fetchpriority="high" data-frame />
  <Image class="only-dark" src={en ? handEnDark : handZhDark} alt={s.hand} widths={[640, 960, 1400, 1800]} sizes="(max-width: 640px) 120vw, 880px"
    format="webp" loading="lazy" data-frame />
</div>
