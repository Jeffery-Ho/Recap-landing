---
// Builds are listed by version only: the site shows no calendar dates. The full list follows hive.ink/cn/updates:
// title, one-line summary, then New / Improvements / Fixes.
import { changeGroups, releases } from '../../data/releases';
import { copy, localPath, type Locale } from '../../data/site';
interface Props { locale: Locale; limit?: number; compact?: boolean; }
const { locale, limit, compact = false } = Astro.props;
const items = limit ? releases.slice(0, limit) : releases;
const groups = copy[locale].updates.groups;
const anchor = (version: string) => `v${version.replace(/[^0-9]+/g, '-').replace(/-$/, '')}`;
---
<ol class:list={['release-list', { 'release-compact': compact }]}>
  {items.map((release) => {
    const inner = (
      <>
        <span class="release-version">v{release.version}</span>
        <span class="release-title">{release.title[locale]}</span>
        <span class="release-summary">{release.body[locale]}</span>
      </>
    );
    if (compact) return <li><a class="release-row" href={`${localPath(locale, 'changelog')}#${anchor(release.version)}`}>{inner}</a></li>;
    const changes = release.changes[locale];
    return (
      <li id={anchor(release.version)} class="release-row">
        {inner}
        <div class="release-changes">
          {changeGroups.filter((group) => changes[group]?.length).map((group) => (
            <section class="release-group">
              <h3>{groups[group]}</h3>
              <ul>{changes[group]!.map((item) => <li>{item}</li>)}</ul>
            </section>
          ))}
        </div>
      </li>
    );
  })}
</ol>
