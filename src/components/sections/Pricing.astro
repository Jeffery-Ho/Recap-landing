---
// Pricing after savee.com's "Go Pro. Save without limits.": a two-part title, one paragraph that explains Absolute,
// then two cards with a large price, one billing line, a short list and the button at the bottom.
import { Check } from '@lucide/astro';
import { copy, pricing, type Locale } from '../../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const p = copy[locale].pricingCopy;
const [monthly, yearly, lifetime] = pricing[locale];
const altPrices = p.absolute.altPrices.replace('{monthly}', monthly.price).replace('{yearly}', yearly.price);
---
<section id="pricing" class="section container" aria-labelledby="pricing-title">
  <h2 id="pricing-title" class="section-title" data-enter><span>{p.title[0]}</span> <span class="muted">{p.title[1]}</span></h2>
  <p class="feature-body" data-enter>{p.lead}</p>
  <div class="pricing-grid">
    <article class="price-card" data-enter>
      <h3>{p.free.name}</h3>
      <p class="price-description">{p.free.description}</p>
      <p class="price-amount">{p.free.price}</p>
      <p class="price-note">{p.free.priceNote}</p>
      <ul class="price-features">{p.free.features.map((feature) => <li><Check size={16} stroke-width={2.2} aria-hidden="true" />{feature}</li>)}</ul>
      <a class="button button-outline-neutral" href="#install">{p.free.cta}</a>
    </article>
    <article class="price-card price-card-absolute" data-enter>
      <h3>{p.absolute.name}<span class="price-tag">{p.recommended}</span></h3>
      <p class="price-description">{p.absolute.description}</p>
      <p class="price-amount">{lifetime.price}</p>
      <p class="price-note">{p.absolute.priceNote} · {altPrices}</p>
      <ul class="price-features">{p.absolute.features.map((feature) => <li><Check size={16} stroke-width={2.2} aria-hidden="true" />{feature}</li>)}</ul>
      <a class="button button-primary" href="#install">{p.absolute.cta}</a>
    </article>
  </div>
  <p class="pricing-footnote">{p.footnote}</p>
</section>
