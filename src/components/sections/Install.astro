---
// Install, kept short: a two-part title, one line, the beta button, three numbered steps and the App Store status.
import StoreBadges from '../StoreBadges.astro';
import { copy, type Locale } from '../../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const i = copy[locale].install;
---
<section id="install" class="section container" aria-labelledby="install-title">
  <h2 id="install-title" class="section-title" data-enter><span>{i.title[0]}</span> <span class="muted">{i.title[1]}</span></h2>
  <p class="feature-body" data-enter>{i.lead}</p>
  <div class="block-action" data-enter><StoreBadges locale={locale} /></div>
  <ol class="install-steps" data-enter>{i.steps.map((step) => <li>{step}</li>)}</ol>
  <p class="install-note">{i.note}</p>
</section>
