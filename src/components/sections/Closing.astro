---
// Closing line above the footer, after savee.com's "Made for visual minds": one large sentence and the beta button.
import StoreBadges from '../StoreBadges.astro';
import { copy, type Locale } from '../../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
---
<section class="closing container" aria-labelledby="closing-title" data-closing>
  <h2 id="closing-title" data-enter>{t.closingTitle.map((line) => <span>{line}</span>)}</h2>
  <div class="closing-actions"><StoreBadges locale={locale} /></div>
</section>
