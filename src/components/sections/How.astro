---
// How Recap sorts photos, after Polaris v2's feature gallery: a centred two-part title, then a full-bleed row of large
// slides (copy on the left, the feature on the right) that snaps one slide at a time. The next slide peeks in faded;
// a pill of dots below shows the current slide, its dot filling as an 8-second progress bar (motion.ts). Without
// JavaScript the row still scrolls sideways.
import type { ImageMetadata } from 'astro';
import PhotoStrip from '../PhotoStrip.astro';
import WeekPhone from '../WeekPhone.astro';
import { copy, type Locale } from '../../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const intro = copy[locale].featuresIntro;
const features = copy[locale].features;

// Strip photos, registered in src/data/photography-sources.json. Each appears once on the page.
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/library/strip/*.jpg', { eager: true });
const strip = (name: string) => files[`../../assets/library/strip/${name}.jpg`].default;
const set = (...names: string[]) => names.map(strip);
const photos: Record<string, ImageMetadata[][]> = {
  places: [
    set('OnboardingPlaces01', 'OnboardingWelcome03', 'OnboardingPlaces04', 'OnboardingWelcome05', 'OnboardingWelcome14', 'OnboardingWelcome16'),
    set('OnboardingRandom03', 'OnboardingRandom09', 'OnboardingRandom04', 'OnboardingRandom08', 'OnboardingRandom12', 'OnboardingRandom11'),
    set('remote-iceland-sea-06', 'remote-iceland-mountain-06', 'remote-iceland-sunset-06', 'remote-iceland-sea-07', 'remote-iceland-mountain-07', 'remote-iceland-sunset-07'),
  ],
  categories: [
    set('OnboardingCategory01', 'remote-pet-dog-02', 'OnboardingCategory03', 'remote-pet-dog-03', 'OnboardingCategory02', 'remote-pet-cat-01'),
    set('OnboardingCategory04', 'OnboardingCategory06', 'OnboardingPaywall07', 'OnboardingCategory05', 'OnboardingPaywall17', 'remote-kyoto-sakura-01'),
    set('OnboardingCategory09', 'OnboardingRandom06', 'OnboardingRandom05', 'remote-iceland-sea-03', 'OnboardingRandom07', 'OnboardingPaywall01'),
    set('OnboardingCategory07', 'OnboardingRandom14', 'OnboardingCategory08', 'remote-iceland-sunset-03', 'OnboardingRandom10', 'OnboardingPaywall18'),
  ],
};
---
<section id="features" class="section features-section" aria-labelledby="features-title">
  <div class="container">
    {locale === 'zh' && <p class="section-kicker">整理方案</p>}
    <h2 id="features-title" class="section-title" data-enter><span>{intro.title[0]}</span> <span class="muted">{intro.title[1]}</span></h2>
    <p class="feature-body" data-enter>{intro.body}</p>
  </div>
  <div class="feature-gallery" data-feature-gallery data-enter aria-roledescription="carousel" aria-label={intro.label}>
    <div class="feature-track" data-feature-track tabindex="0">
      {features.map((feature, i) => (
        <article id={`feature-${feature.id}`} class:list={['feature-slide', { 'is-active': i === 0 }]} data-feature-slide
          aria-roledescription="slide" aria-labelledby={`feature-${feature.id}-title`}>
          <div class="feature-slide-copy">
            <p class="feature-label">{feature.label}</p>
            <h3 id={`feature-${feature.id}-title`} class="feature-slide-title"><span>{feature.title[0]}</span> <span class="muted">{feature.title[1]}</span></h3>
            <p class="feature-slide-text">{feature.body}</p>
          </div>
          <div class="feature-slide-visual">
            {feature.id === 'week'
              ? <WeekPhone locale={locale} />
              : <PhotoStrip states={feature.states} photos={photos[feature.id]} icon={feature.icon} layout="grid" />}
          </div>
        </article>
      ))}
    </div>
    <div class="feature-controls">
      <div class="feature-dots" role="group" aria-label={intro.choose}>
        {features.map((feature, i) => (
          <button type="button" class:list={['feature-dot', { 'is-current': i === 0 }]} data-feature-dot={i}
            aria-controls={`feature-${feature.id}`} aria-current={i === 0 ? 'true' : undefined}>
            <span class="sr-only">{feature.label}</span><span class="feature-dot-fill" aria-hidden="true"></span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>
