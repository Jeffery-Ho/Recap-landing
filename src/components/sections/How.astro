---
// Chapter 01, how Recap sorts photos, after Polaris v2's feature gallery: a centred two-part title, then a full-bleed row of large
// slides (copy on the left, the feature on the right) that snaps one slide at a time. The next slide peeks in faded;
// a pill of dots below shows the current slide, its dot filling as an 8-second progress bar (motion.ts). Without
// JavaScript the row still scrolls sideways.
import type { ImageMetadata } from 'astro';
import PhotoStrip from '../PhotoStrip.astro';
import WeekPhone from '../WeekPhone.astro';
import ChapterHeader from '../ChapterHeader.astro';
import CleanupScene from '../scenes/CleanupScene.astro';
import PlacesMapScene from '../scenes/PlacesMapScene.astro';
import { copy, type Locale } from '../../data/site';
import { slot } from '../../data/photos';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const intro = t.featuresIntro;
const features = copy[locale].features;

// Photo sets from the shared library (photos/manifest.json); each appears once on the page.
const photos: Record<string, ImageMetadata[][]> = {
  categories: [slot('categories:pets'), slot('categories:flowers'), slot('categories:sunset'), slot('categories:mountain')],
};
---
<section id="features" class="section features-section" aria-labelledby="features-title">
  <div class="container">
    {locale === 'zh' && <p class="section-kicker">整理方案</p>}
    <ChapterHeader id="features-title" number={1} label={t.chapters.sort} title={intro.title} body={intro.body} />
  </div>
  <div class="feature-gallery" data-feature-gallery data-enter aria-roledescription="carousel" aria-label={intro.label}>
    <div class="feature-track" data-feature-track tabindex="0">
      {features.map((feature, i) => (
        <article id={`feature-${feature.id}`} class:list={['feature-slide', { 'is-active': i === 0 }]} data-feature-slide
          aria-roledescription="slide" aria-labelledby={`feature-${feature.id}-title`}>
          <div class="feature-slide-copy">
            <p class="feature-label">{feature.label}</p>
            <h3 id={`feature-${feature.id}-title`} class="feature-slide-title"><span>{feature.title[0]}</span> <span class="muted">{feature.title[1]}</span></h3>
            <p class="feature-slide-text">{feature.body}</p>
          </div>
          <div class="feature-slide-visual">
            {feature.id === 'week' && <WeekPhone locale={locale} />}
            {feature.id === 'places' && <PlacesMapScene locale={locale} />}
            {feature.id === 'cleanup' && <CleanupScene states={feature.states} />}
            {photos[feature.id] && <PhotoStrip states={feature.states} photos={photos[feature.id]} icon={feature.icon} layout="grid" />}
          </div>
        </article>
      ))}
    </div>
    <div class="feature-controls">
      <div class="feature-dots" role="group" aria-label={intro.choose}>
        {features.map((feature, i) => (
          <button type="button" class:list={['feature-dot', { 'is-current': i === 0 }]} data-feature-dot={i}
            aria-controls={`feature-${feature.id}`} aria-current={i === 0 ? 'true' : undefined}>
            <span class="sr-only">{feature.label}</span><span class="feature-dot-fill" aria-hidden="true"></span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>
