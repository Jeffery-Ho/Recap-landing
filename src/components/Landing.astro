---
import { Image } from 'astro:assets';
import { Shuffle, Frame, MessageCircle } from '@lucide/astro';
import BetaButton from './BetaButton.astro';
import { copy, localPath, site, type Locale } from '../data/site';
import homeScreen from '../assets/screens/home.png';
import cityScreen from '../assets/screens/cities.png';
import weekScreen from '../assets/screens/week.png';
import iceland from '../assets/photos/iceland.png';
import kyoto from '../assets/photos/kyoto.png';
import glacier from '../assets/photos/glacier.png';
import coast from '../assets/photos/coast.jpg';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const icons = { random: Shuffle, share: Frame, assistant: MessageCircle };
const features = [
  { id: 'weekly', number: '01', content: t.weekly, image: weekScreen },
  { id: 'cities', number: '02', content: t.cities, image: cityScreen },
  { id: 'themes', number: '03', content: t.themes, image: homeScreen },
];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-copy">
    <p class="eyebrow hero-eyebrow"><span class="sky-dot" aria-hidden="true"></span>{t.beta}</p>
    <h1 id="hero-title">{t.heroLines[0]}<br /><span>{t.heroLines[1]}</span></h1>
    <p class="hero-description">{t.heroDescription}</p>
    <div class="hero-actions"><BetaButton locale={locale} /><a class="button button-secondary" href="#features">{t.explore}<span aria-hidden="true">↓</span></a></div>
    <p class="requirements">{t.requirements}</p>
  </div>
  <div class="container hero-visual">
    <figure class="memory-print memory-left">
      <Image src={iceland} alt={t.icelandAlt} widths={[240, 480, 720]} sizes="(max-width: 640px) 125px, 250px" format="webp" loading="eager" />
      <figcaption>{t.photoLabelLeft}</figcaption>
    </figure>
    <div class="phone hero-phone">
      <Image src={homeScreen} alt={t.heroAlt} widths={[320, 640, 960]} sizes="(max-width: 640px) 228px, 290px" format="webp" loading="eager" fetchpriority="high" />
    </div>
    <figure class="memory-print memory-right">
      <Image src={kyoto} alt={t.kyotoAlt} widths={[240, 480, 720]} sizes="(max-width: 640px) 125px, 250px" format="webp" loading="eager" />
      <figcaption>{t.photoLabelRight}</figcaption>
    </figure>
    <div class="visual-orbit orbit-one" aria-hidden="true"></div>
    <div class="visual-orbit orbit-two" aria-hidden="true"></div>
  </div>
  <p class="visual-caption">{t.screenshotNote}</p>
</section>

<div id="features" class="features">
  {features.map(({ id, number, content, image }) => (
    <section id={id} class:list={['feature-section', `feature-${id}`]} aria-labelledby={`${id}-title`}>
      <div class="container feature-grid">
        <div class="feature-copy">
          <span class="section-number">{number} / RECAP</span>
          <p class="eyebrow">{content.eyebrow}</p>
          <h2 id={`${id}-title`}>{content.title.split('\n').map((line) => <span>{line}</span>)}</h2>
          <p class="feature-description">{content.body}</p>
          <p class="feature-detail"><span class="detail-dash" aria-hidden="true"></span>{content.detail}</p>
        </div>
        <figure class="feature-visual">
          {id === 'weekly' && <div class="back-photo back-photo-week"><Image src={glacier} alt="" widths={[240, 480]} sizes="200px" format="webp" /></div>}
          {id === 'cities' && <div class="back-photo back-photo-city"><Image src={kyoto} alt="" widths={[240, 480]} sizes="200px" format="webp" /></div>}
          {id === 'themes' && <div class="back-photo back-photo-theme"><Image src={coast} alt="" widths={[240, 480]} sizes="200px" format="webp" /></div>}
          <div class="phone feature-phone"><Image src={image} alt={content.alt} widths={[320, 640, 960]} sizes="(max-width: 640px) 240px, 270px" format="webp" /></div>
          <figcaption>{t.screenshotNote}</figcaption>
        </figure>
      </div>
    </section>
  ))}
</div>

<section class="more-section container" aria-labelledby="more-title">
  <div class="section-heading"><p class="eyebrow">{t.moreEyebrow}</p><h2 id="more-title">{t.moreTitle}</h2></div>
  <div class="more-grid">
    {t.more.map((item) => { const Icon = icons[item.kind]; return (
      <article class="more-card">
        <div class="more-symbol" aria-hidden="true"><Icon size={29} stroke-width={1.5} /></div>
        <span class="more-number">{item.number}</span>
        <h3>{item.title}</h3><p>{item.body}</p><span class="feature-label">{item.label}</span>
      </article>
    ); })}
  </div>
  <p class="assistant-note">{t.assistantNote}</p>
</section>

<section class="privacy-section" aria-labelledby="privacy-title">
  <div class="container privacy-grid">
    <div class="privacy-mark" aria-hidden="true"><img src="/app-icon.png" width="148" height="148" alt="" loading="lazy" /><span>Recap.</span></div>
    <div class="privacy-copy"><p class="eyebrow">{t.privacyEyebrow}</p><h2 id="privacy-title">{t.privacyTitle.split('\n').map((line) => <span>{line}</span>)}</h2>
      <p>{t.privacyBody}</p>
      <ul class="privacy-points">{t.privacyItems.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
      <p class="privacy-note">{t.privacyNote}</p><a class="text-link" href={localPath(locale, 'privacy')}>{t.privacyLink}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<section id="faq" class="faq-section container" aria-labelledby="faq-title">
  <div class="section-heading"><p class="eyebrow">{t.faqEyebrow}</p><h2 id="faq-title">{t.faqTitle}</h2></div>
  <div class="faq-list">
    {t.questions.map((item) => (
      <details id={item.id}><summary>{item.question}<span aria-hidden="true" class="faq-toggle">+</span></summary><div class="faq-answer"><p>{item.id === 'installation' && site.testflightUrl ? (locale === 'en' ? 'Open the public invitation using a beta button on this page. Install Apple’s TestFlight, accept the invitation, then install Recap. TestFlight availability is managed by Apple and the developer.' : '点击页面上的测试按钮，打开公开邀请。安装 Apple TestFlight、接受邀请后，即可安装 Recap。测试名额和可用性由 Apple 与开发者管理。') : item.answer}</p>{item.id === 'contact' && site.contactEmail && <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}</div></details>
    ))}
  </div>
</section>

<section class="closing-section" aria-labelledby="closing-title">
  <div class="container"><p class="eyebrow">{t.closingEyebrow}</p><h2 id="closing-title">{t.closingTitle}</h2><p>{t.closingBody}</p><BetaButton locale={locale} /></div>
</section>
