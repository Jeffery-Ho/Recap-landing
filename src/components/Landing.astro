---
import { Image } from 'astro:assets';
import { Shuffle, Frame, MessageCircle, ArrowDown, ArrowUpRight, Plus, Minus } from '@lucide/astro';
import BetaButton from './BetaButton.astro';
import { copy, localPath, site, type Locale } from '../data/site';
import homeScreen from '../assets/screens/home.png';
import cityScreen from '../assets/screens/cities.png';
import weekScreen from '../assets/screens/week.png';
import homeScreenEn from '../assets/screens/en/home.png';
import cityScreenEn from '../assets/screens/en/cities.png';
import weekScreenEn from '../assets/screens/en/week.png';
import handheldPhone from '../assets/mockups/handheld-phone-v1.png';
import kyoto from '../assets/photos/kyoto.png';
import glacier from '../assets/photos/glacier.png';
import iceland from '../assets/photos/iceland.png';
import themePet from '../assets/theme-photos/pet.jpg';
import themeFlowers from '../assets/theme-photos/flowers.jpg';
import themeSea from '../assets/theme-photos/sea.jpg';
import themeSunset from '../assets/theme-photos/sunset.jpg';
import themeMountain from '../assets/theme-photos/mountain.jpg';
import themeGathering from '../assets/theme-photos/gathering.jpg';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const screens = locale === 'en'
  ? { home: homeScreenEn, cities: cityScreenEn, week: weekScreenEn }
  : { home: homeScreen, cities: cityScreen, week: weekScreen };
const themePhotos = locale === 'en'
  ? [
      { image: themePet, label: 'Pet friends', alt: 'A golden dog outdoors' },
      { image: themeFlowers, label: 'Flowers', alt: 'Fresh flowers in bloom' },
      { image: themeSea, label: 'By the sea', alt: 'Ocean waves along the coast' },
      { image: themeSunset, label: 'Sunset moments', alt: 'Sunset over the water' },
      { image: themeMountain, label: 'Mountain air', alt: 'A mountain landscape' },
      { image: themeGathering, label: 'Gatherings', alt: 'A lively evening gathering' },
    ]
  : [
      { image: themePet, label: '宠物时光', alt: '户外的金毛犬' },
      { image: themeFlowers, label: '花卉', alt: '盛开的鲜花' },
      { image: themeSea, label: '海边', alt: '海岸边的海浪' },
      { image: themeSunset, label: '日落时刻', alt: '水面上的日落' },
      { image: themeMountain, label: '山野', alt: '山间风景' },
      { image: themeGathering, label: '相聚', alt: '热闹的夜晚聚会' },
    ];
const icons = { random: Shuffle, share: Frame, assistant: MessageCircle };
const features = [
  { id: 'weekly', content: t.weekly, image: screens.week },
  { id: 'cities', content: t.cities, image: screens.cities },
  { id: 'themes', content: t.themes, image: screens.home },
];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-copy">
    <h1 id="hero-title">{t.heroLines[0]}<br /><span>{t.heroLines[1]}</span></h1>
    <p class="hero-description">{t.heroDescription}</p>
    <div class="hero-actions"><BetaButton locale={locale} /><a class="button button-secondary" href="#features">{t.explore}<ArrowDown size={17} aria-hidden="true" /></a></div>
  </div>
  <div class="container hero-visual">
    <div class="handheld-phone">
      <Image class="handheld-model" src={handheldPhone} alt="" widths={[512, 768, 1024]} sizes="(max-width: 700px) 520px, 620px" format="webp" loading="eager" fetchpriority="high" />
      <div class="handheld-screen"><Image src={screens.home} alt={t.heroAlt} widths={[320, 640, 960]} sizes="(max-width: 700px) 219px, 261px" format="webp" loading="eager" fetchpriority="high" /></div>
    </div>
  </div>
</section>

<div id="features" class="features">
  {features.map(({ id, content, image }) => (
    <section id={id} class:list={['feature-section', `feature-${id}`]} aria-labelledby={`${id}-title`}>
      <div class="container feature-grid">
        <div class="feature-copy">
          <h2 id={`${id}-title`}>{content.title.split('\n').map((line) => <span>{line}</span>)}</h2>
          <p class="feature-description">{content.body}</p>
        </div>
        <figure class="feature-visual">
          {id === 'weekly' && <div class="back-photo back-photo-week"><Image src={glacier} alt="" widths={[240, 480]} sizes="184px" format="webp" /></div>}
          {id === 'cities' && <div class="back-photo back-photo-city"><Image src={kyoto} alt="" widths={[240, 480]} sizes="184px" format="webp" /></div>}
          {id === 'themes' && <div class="back-photo back-photo-theme"><Image src={iceland} alt="" widths={[240, 480]} sizes="184px" format="webp" /></div>}
          {id === 'themes' ? (
            <div class="phone feature-phone theme-gallery-phone" aria-label={locale === 'en' ? 'Unique Unsplash theme photographs' : '不重复的 Unsplash 主题照片'}>
              <div class="theme-gallery-heading"><span>{locale === 'en' ? 'For You' : '为你推荐'}</span><span aria-hidden="true">✦</span></div>
              <div class="theme-gallery-grid">
                {themePhotos.map(({ image: photo, label, alt }) => <article class="theme-photo-card"><Image src={photo} alt={alt} widths={[240, 480]} sizes="(max-width: 700px) 100px, 112px" format="webp" /><span>{label}</span></article>)}
              </div>
            </div>
          ) : <div class="phone feature-phone"><Image src={image} alt={content.alt} widths={[320, 640, 960]} sizes="(max-width: 700px) 228px, (max-width: 1000px) 210px, 231px" format="webp" /></div>}
        </figure>
      </div>
    </section>
  ))}
</div>

<section class="more-section container" aria-labelledby="more-title">
  <div class="section-heading"><h2 id="more-title">{t.moreTitle}</h2></div>
  <div class="more-grid">
    {t.more.map((item) => { const Icon = icons[item.kind]; return (
      <article class="more-card">
        <div class="more-symbol" aria-hidden="true"><Icon size={29} stroke-width={1.5} /></div>
        <h3>{item.title}</h3><p>{item.body}</p>
      </article>
    ); })}
  </div>
</section>

<section class="privacy-section" aria-labelledby="privacy-title">
  <div class="container privacy-grid">
    <div class="privacy-mark" aria-hidden="true"><img src="/app-icon.png" width="148" height="148" alt="" loading="lazy" /><span>Recap.</span></div>
    <div class="privacy-copy"><h2 id="privacy-title">{t.privacyTitle.split('\n').map((line) => <span>{line}</span>)}</h2>
      <p>{t.privacyBody} {t.privacyNote}</p><a class="text-link" href={localPath(locale, 'privacy')}>{t.privacyLink}<ArrowUpRight size={17} aria-hidden="true" /></a>
    </div>
  </div>
</section>

<section id="faq" class="faq-section container" aria-labelledby="faq-title">
  <div class="section-heading"><h2 id="faq-title">{t.faqTitle}</h2></div>
  <div class="faq-list">
    {t.questions.map((item) => (
      <details id={item.id}><summary>{item.question}<span aria-hidden="true" class="faq-toggle"><Plus class="faq-icon-closed" size={20} stroke-width={1.5} /><Minus class="faq-icon-open" size={20} stroke-width={1.5} /></span></summary><div class="faq-answer"><p>{item.id === 'installation' && site.testflightUrl ? (locale === 'en' ? 'Open the public invitation using a beta button on this page. Install Apple’s TestFlight, accept the invitation, then install Recap. TestFlight availability is managed by Apple and the developer.' : '点击页面上的测试按钮，打开公开邀请。安装 Apple TestFlight、接受邀请后，即可安装 Recap。测试名额和可用性由 Apple 与开发者管理。') : item.answer}</p>{item.id === 'contact' && site.contactEmail && <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}</div></details>
    ))}
  </div>
</section>

<section class="closing-section" aria-labelledby="closing-title">
  <div class="container"><h2 id="closing-title">{t.closingTitle}</h2><p>{t.closingBody}</p><BetaButton locale={locale} /></div>
</section>
