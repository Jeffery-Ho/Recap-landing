---
import Hero from './sections/Hero.astro';
import How from './sections/How.astro';
import Browse from './sections/Browse.astro';
import Share from './sections/Share.astro';
import Heatmap from './sections/Heatmap.astro';
import Privacy from './sections/Privacy.astro';
import Pricing from './sections/Pricing.astro';
import Install from './sections/Install.astro';
import Faq from './sections/Faq.astro';
import ReleaseNotes from './sections/ReleaseNotes.astro';
import type { Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
---
<Hero locale={locale} />
<How locale={locale} />
<Browse locale={locale} />
<Share locale={locale} />
<Heatmap locale={locale} />
<Privacy locale={locale} />
<Pricing locale={locale} />
<Install locale={locale} />
<Faq locale={locale} />
<ReleaseNotes locale={locale} />
