---
// A pill that cycles through a few states (typed out, like Savee's search field) above a full-bleed row of photos
// that swap with each state. Each slot stacks one photo per state; the current state's photo is shown.
// Without JavaScript, or with reduced motion, the first state stays on screen. `grid` lays the photos out 3 × 2 inside
// a feature slide instead of a full-bleed row.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { states: readonly string[]; photos: ImageMetadata[][]; icon: 'calendar' | 'pin' | 'sparkle' | 'layers'; layout?: 'row' | 'grid'; }
const { states, photos, icon, layout = 'row' } = Astro.props;
const slots = photos[0].length;
---
<div class:list={['strip', { 'strip--grid': layout === 'grid' }]} data-strip data-states={JSON.stringify(states)}>
  <p class="strip-pill">
    <svg class="strip-icon" viewBox="0 0 24 24" aria-hidden="true">
      {icon === 'calendar' && <><rect x="4" y="5" width="16" height="15" rx="3" /><path d="M4 10h16M9 3v4M15 3v4" /></>}
      {icon === 'pin' && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></>}
      {icon === 'sparkle' && <path d="M12 3.5l1.9 5.1 5.1 1.9-5.1 1.9-1.9 5.1-1.9-5.1-5.1-1.9 5.1-1.9Z" />}
      {icon === 'layers' && <><path d="M8 4h11a1 1 0 0 1 1 1v11" /><rect x="4" y="8" width="12" height="12" rx="2" /></>}
    </svg>
    <span class="strip-text" data-strip-text>{states[0]}</span>
  </p>
  <div class="strip-row" aria-hidden="true">
    {Array.from({ length: slots }, (_, i) => (
      <div class="strip-slot" style={`--i:${i}`}>
        {photos.map((set, s) => (
          <Image class:list={['strip-layer strip-photo', { 'is-current': s === 0 }]} data-s={s} src={set[i]} alt="" widths={[240, 480]} sizes={layout === 'grid' ? '(max-width: 800px) 30vw, 180px' : '(max-width: 640px) 120px, 200px'} format="webp" loading="lazy" />
        ))}
      </div>
    ))}
  </div>
</div>
